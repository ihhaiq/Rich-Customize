BOT_TOKEN=123456789:AbC
DEVELOPER_ID=YOUR_TELEGRAM_NUMERIC_ID
LOG_LEVEL=INFO
SHOWCASE_MEDIA_CHANNEL_ID=CHANNEL_ID

# Public Mini App backend URL. Railway can normally use RAILWAY_PUBLIC_DOMAIN automatically.
# Set MINI_APP_URL only when you want to override the public URL.
# Example: MINI_APP_URL=https://example.up.railway.app/miniapp
MINI_APP_URL=

# Direct/Named Mini App short name configured in BotFather.
# The code defaults to "editor", so configure the Named Mini App in BotFather
# with short name: editor. Public link: https://t.me/RichCustomizebot/editor
MINI_APP_SHORT_NAME=editor

# Rich media metadata cache. Telegram keeps the actual files; this only controls
# the bot's local file_id registry. Saved page codes pin their referenced ids.
RICH_MEDIA_STATE=data/rich_media.json
RICH_MEDIA_TTL_SECONDS=604800
RICH_MEDIA_CLEANUP_INTERVAL=21600
RICH_PAGES_STATE=data/rich_pages.json
PAGE_NAVIGATION_STATE=data/page_navigation.json
MANAGED_CHATS_STATE=data/managed_chats.json
GUEST_MESSAGES_STATE=data/guest_messages.json
BUTTON_POPUPS_STATE=data/button_popups.json
SHOWCASE_MEDIA_LIBRARY=data/showcase_media.json
BOT_PROFILE_STATE=data/bot_profile.json
