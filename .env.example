BOT_TOKEN=123456789:replace_with_your_bot_token
DEVELOPER_ID=123456789
LOG_LEVEL=INFO
SHOWCASE_MEDIA_CHANNEL_ID=-1001234567890

# Railway: reference DATABASE_URL from the PostgreSQL service. If it is absent
# or unreachable, the bot immediately continues with the JSON paths below.
DATABASE_URL=
# Leave DATABASE_POOL_MAX_SIZE empty to divide DATABASE_POOL_TOTAL_BUDGET by worker count.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=
DATABASE_POOL_TOTAL_BUDGET=20
DATABASE_CONNECT_TIMEOUT=5
DATABASE_COMMAND_TIMEOUT=5
DATABASE_MIGRATION_TIMEOUT=20
DATABASE_RECONNECT_INTERVAL=30
DATABASE_CIRCUIT_FAILURES=3
DATABASE_CIRCUIT_COOLDOWN=30
DATABASE_FALLBACK_STATE=data/database_fallback.json

# Optional but recommended for persistent FSM, distributed throttling/locks and caches.
REDIS_URL=
REDIS_CONNECT_TIMEOUT=2
REDIS_COMMAND_TIMEOUT=2
REDIS_MAX_CONNECTIONS=20

# Backup/restore maintenance.
PAGE_SNAPSHOT_INTERVAL=21600
RESTORE_DRILL_INTERVAL=86400

# Optional observability.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Public Mini App URL. Railway normally supplies RAILWAY_PUBLIC_DOMAIN.
MINI_APP_URL=
MINI_APP_SHORT_NAME=editor

# Persistent state. Mount the data directory on a persistent volume in production.
RICH_PAGES_STATE=data/rich_pages.json
RICH_MEDIA_STATE=data/rich_media.json
RICH_MEDIA_TTL_SECONDS=604800
RICH_MEDIA_CLEANUP_INTERVAL=21600
PAGE_NAVIGATION_STATE=data/page_navigation.json
MANAGED_CHATS_STATE=data/managed_chats.json
GUEST_MESSAGES_STATE=data/guest_messages.json
BUTTON_POPUPS_STATE=data/button_popups.json
SHOWCASE_MEDIA_LIBRARY=data/showcase_media.json
SHOWCASE_CHANNEL_STATE=data/showcase_channel.json
BOT_PROFILE_STATE=data/bot_profile.json
